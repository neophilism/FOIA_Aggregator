# FOIA.gov metadata discovery
FOIA_API_KEY=

# Backblaze B2 archive
FOIA_STORAGE_BACKEND=b2
B2_KEY_ID=
B2_APPLICATION_KEY=
# Optional when the application key is scoped to exactly one bucket.
B2_BUCKET=
B2_REGION=us-east-005
B2_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
B2_MAX_ARCHIVE_BYTES=9000000000

# Demo crawler: ingest one not-yet-archived record from each
# source per cycle. Increase deliberately after the presentation corpus exists.
FOIA_CRAWLER_DRY_RUN=false
FOIA_MAX_DOCS_PER_SOURCE=1
FOIA_CRAWLER_INTERVAL_HOURS=6

# Restore the newest verified SQLite snapshot from B2 when /data has no DB.
FOIA_BOOTSTRAP_DB_FROM_B2=true
